# Branch mode: the reference tree and bindir with the branch's nix put first
# on PATH through HARNESS_CLIENT_PACKAGE, so the two sides of a run differ
# only in the binary.  prepare-tree.sh fills @tree@, @nix@, @bash@ and
# @tools@; @branchNix@ is filled from BRANCH_NIX when that is set
# (`BRANCH_NIX=$(nix build .#nix-cli --print-out-paths)`) and otherwise left
# for one `sed` over <dest>/modes/branch.env.  For a daemon run, append
# HARNESS_DAEMON=1 and HARNESS_DAEMON_PACKAGE=<the same package>: the client
# forwards its settings, and a daemon that does not know one warns on the
# client's stderr, which the characterisation tests compare.
HARNESS_TREE=@tree@
HARNESS_NIX_PACKAGE=@nix@
HARNESS_BASH=@bash@
HARNESS_TOOLS_PATH=@tools@
HARNESS_NIX_CONFIG=
HARNESS_CLIENT_PACKAGE=@branchNix@
