# Reference mode: the nix the prepared tree's bindir points at (a Nix built
# from master, the reference of doc/lazy-store/05-validation.md section 3).
# prepare-tree.sh fills @tree@, @nix@, @bash@ and @tools@ from its arguments
# and writes <dest>/modes/reference.env.  The tools PATH starts with the
# mode's bash because `nix develop`, `nix-shell` and the tests' builders
# resolve `bash` from PATH, as they would inside stdenv.
HARNESS_TREE=@tree@
HARNESS_NIX_PACKAGE=@nix@
HARNESS_BASH=@bash@
HARNESS_TOOLS_PATH=@tools@
HARNESS_NIX_CONFIG=
HARNESS_CLIENT_PACKAGE=
