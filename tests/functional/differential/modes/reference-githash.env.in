# The reference side of a branch-against-reference run: the reference binary
# with `git-hashing` enabled, since master parses `fixed:git:` content
# addresses only under that experimental feature and every source the branch
# adds is named that way (01-specification.md section 9.9).  The branch
# answers the line with a one-line "has been stabilized" warning.  Filled by
# prepare-tree.sh like reference.env.in.
HARNESS_TREE=@tree@
HARNESS_NIX_PACKAGE=@nix@
HARNESS_BASH=@bash@
HARNESS_TOOLS_PATH=@tools@
HARNESS_NIX_CONFIG='extra-experimental-features = git-hashing'
HARNESS_CLIENT_PACKAGE=
