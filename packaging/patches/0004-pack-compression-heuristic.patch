+int git_zstream_set_level(git_zstream *zstream, int level)
+{
+	if (zstream->type != GIT_ZSTREAM_DEFLATE || zstream->level == level)
+		return 0;
+
+	zstream->zerr = GIT_ZLIB_SYMBOL(deflateParams)(&zstream->z, level, Z_DEFAULT_STRATEGY);
+	if (zstream_seterr(zstream) < 0)
+		return -1;
+
+	zstream->level = level;
+	return 0;
+}
+
+bool git_zstream_worth_deflating(git_zstream *probe, const void *in, size_t in_len)
+{
+	unsigned char sample[GIT_ZSTREAM_PROBE_LEN];
+	unsigned char out[GIT_ZSTREAM_PROBE_LEN];
+	size_t i, stride, out_len = sizeof(out);
+
+	if (in_len <= GIT_ZSTREAM_PROBE_LEN)
+		return true;
+
+	/*
+	 * Slice i begins at i * stride: the first slice at the start of the
+	 * input, the last ending at its end, the rest evenly between.  A
+	 * sample from the start alone would misjudge data that opens with a
+	 * compressible header and continues with what is not.
+	 */
+	stride = (in_len - GIT_ZSTREAM_PROBE_SLICE_LEN) / (GIT_ZSTREAM_PROBE_SLICES - 1);
+	for (i = 0; i < GIT_ZSTREAM_PROBE_SLICES; i++)
+		memcpy(sample + i * GIT_ZSTREAM_PROBE_SLICE_LEN,
+		       (const unsigned char *)in + i * stride,
+		       GIT_ZSTREAM_PROBE_SLICE_LEN);
+
+	/*
+	 * One deflate call over the whole sample, with an output buffer of the
+	 * sample's own size: output that does not fit ends the call short of
+	 * the stream's end (Z_OK or Z_BUF_ERROR, neither fatal) and reads as
+	 * "did not shrink".  A zlib error answers yes, so that the write goes
+	 * on as it always has and reports the error there if it persists.
+	 */
+	git_zstream_reset(probe);
+	if (git_zstream_set_input(probe, sample, sizeof(sample)) < 0 ||
+	    git_zstream_get_output_chunk(out, &out_len, probe) < 0)
+		return true;
+
+	return git_zstream_eos(probe) &&
+	       out_len * 100 <= sizeof(sample) * (100 - GIT_ZSTREAM_PROBE_MIN_GAIN);
 }
 
